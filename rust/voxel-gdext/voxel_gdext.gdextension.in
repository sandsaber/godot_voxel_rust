[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
# Reloadable on Linux/macOS (class changes hot-reload without editor restart).
# Disable if you hit gdext reload issues during development.
reloadable = true

[libraries]
# Paths are relative to THIS file (res://rust/voxel-gdext/). Build the artifact
# first with `cargo build -p voxel-gdext` (debug) or `--release`, then either
# copy it next to this file or point the paths at target/.
#
# Godot 4.7 uses plain "<os>.<arch>" keys (no .debug/.release suffix).
# Linux x86_64:
linux.x86_64 = "res://rust/target/debug/libvoxel_gdext.so"
# macOS (universal arm64+x86_64 if you lipo them; here arm64):
macos = "res://rust/target/debug/libvoxel_gdext.dylib"
# Windows x86_64:
windows.x86_64 = "res://rust/target/debug/voxel_gdext.dll"
# Android arm64 (device) + x86_64 (emulator). Built with the NDK via
# `rust/scripts/android-build.sh` (defaults to aarch64 .so; pass
# `--target x86_64-linux-android` for the emulator variant):
android.arm64 = "res://rust/target/aarch64-linux-android/release/libvoxel_gdext.so"
android.x86_64 = "res://rust/target/x86_64-linux-android/release/libvoxel_gdext.so"
